#!/bin/sh
# Secret scan of the staged changes, before they become a commit.
#
# Opt in once per clone:   git config core.hooksPath .githooks
#
# Uses the repository's .gitleaks.toml (built-in rules plus the project's own
# credential formats), named with --config so that gitleaks reads no other
# config file (it would take a .gitleaks.json first), and .gitleaksignore.
# Without .gitleaks.toml the hook fails. This hook is the early warning: a
# secret caught here never enters the history. A hook can be skipped; a scan
# of the pushed commits in CI cannot — if the project has one. Without it,
# this hook is the only secret scan. Output is redacted, so a hit never prints
# the secret itself.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it (>= 8.25), e.g. brew install gitleaks" >&2
  echo "pre-commit: or turn the hooks off for this clone: git config --unset core.hooksPath" >&2
  exit 1
fi

exec gitleaks git --config .gitleaks.toml --staged --redact --exit-code 1 --no-banner --verbose
